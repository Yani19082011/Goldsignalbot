# Copy this file to .env for local testing (Render: set these as
# Environment Variables in the service's Settings tab instead).

# Required - get a free key at https://resend.com/api-keys
RESEND_API_KEY=

# Where alerts get sent. Note: on Resend's free/sandbox tier (no verified
# domain), you can only send to the email address of your own Resend
# account. Verify a domain at https://resend.com/domains to send anywhere.
# The sandbox sender domain is "resend.dev", not "resend.com".
ALERT_EMAIL=yani.kolev2011@gmail.com
ALERT_FROM_EMAIL=GoldSignalBot <onboarding@resend.dev>

# Optional but recommended: a free Twelve Data key (twelvedata.com, no card
# needed, 800 requests/day) used as an automatic backup if Yahoo Finance is
# unreachable or rate-limits the bot. Leave blank to skip this source.
TWELVEDATA_API_KEY=

# Candle size for the indicators. 5m/15m/30m/60m are all supported.
CANDLE_INTERVAL=15m

# How often (minutes) the bot checks the market. Checking much more often
# than CANDLE_INTERVAL above just re-reads the same still-forming candle.
CHECK_INTERVAL_MINUTES=5

# How many of the 5 confluence conditions must agree (3-5)
CONFLUENCE_THRESHOLD=4

# Don't re-send the same BUY/SELL alert more often than this (hours)
REALERT_COOLDOWN_HOURS=6

# Send a "bot started" test email on boot, useful to confirm Resend works
SEND_TEST_EMAIL_ON_START=true
