# Copy this file to .env for local testing (Render: set these as
# Environment Variables in the service's Settings tab instead).

# Required - get a free key at https://resend.com/api-keys
RESEND_API_KEY=

# Where alerts get sent. Note: on Resend's free/sandbox tier (no verified
# domain), you can only send to the email address of your own Resend
# account. Verify a domain at https://resend.com/domains to send anywhere.
# The sandbox sender domain is "resend.dev", not "resend.com".
ALERT_EMAIL=yani.kolev2011@gmail.com
ALERT_FROM_EMAIL=GoldSignalBot <onboarding@resend.dev>

# Optional but recommended: a free Twelve Data key (twelvedata.com, no card
# needed, 800 requests/day) used as an automatic backup if Yahoo Finance is
# unreachable or rate-limits the bot. Leave blank to skip this source.
# Used as Twelve Data's symbol for GOLD specifically (kept as TWELVEDATA_SYMBOL
# for backward compat - Tech100 has its own TECH100_TWELVEDATA_SYMBOL below).
TWELVEDATA_API_KEY=
TWELVEDATA_SYMBOL=XAU/USD

# By user request (24.09 - "цената да се променя, преди не се променяше на
# всеки имейл"): if Yahoo Finance fails (common from Render's IP) AND no
# TWELVEDATA_API_KEY is set above, the bot used to silently fall back to
# stooq.com's DAILY-only candles and keep computing "15-minute" indicators
# on a price that only actually updates once a day - which is exactly why
# it could look frozen for hours. Now that's off by default: if only daily
# data is available, the bot raises (triggers the error-alert email after a
# few failed checks) instead of quietly emailing a stale signal. Strongly
# recommended: just set TWELVEDATA_API_KEY above and this never comes up.
# Set to true only if you'd rather have a coarse once-a-day signal than none.
ALLOW_DAILY_FALLBACK=false

# Per-request timeout (seconds) for every price-data HTTP call. Bounds how
# long one check cycle can take even in the worst case (every source
# failing/hanging back to back) - by user request (24.09), keep the whole
# fetch+analyze+email cycle fast (well under a minute; usually 1-3 seconds).
FETCH_TIMEOUT_SECONDS=8

# --- Instruments -----------------------------------------------------------
# By default (24.09) the bot watches USA Tech 100 only. Gold support is
# still fully built in and tested - set ENABLE_GOLD=true to bring it back
# alongside Tech100 (both run together if both are enabled).
ENABLE_GOLD=false
# Set to false to stop watching Tech100 (e.g. if you only want gold).
ENABLE_TECH100=true
# Yahoo Finance: Nasdaq-100 futures (near-24h, matches how a TECH100 CFD
# trades) with the cash index as fallback (US market hours only).
TECH100_TICKER=NQ=F
TECH100_TICKER_FALLBACK=^NDX
# Twelve Data/stooq don't serve the Nasdaq-100 INDEX directly on this plan
# (confirmed 404 from both on 18.09) - QQQ (the Nasdaq-100 ETF) is used as
# a proxy instead, and its price is scaled up by TECH100_ETF_SCALE below to
# match the real index/CFD level (QQQ's share price is ~41.5x smaller
# because of its 2011 split). See the long comment in config.py.
TECH100_TWELVEDATA_SYMBOL=QQQ
TECH100_STOOQ_SYMBOL=qqq.us
# Nasdaq-100 index / QQQ price ratio, approx (drifts slowly over time -
# bump this if the emailed TECH100 price visibly diverges from your
# broker's quote).
TECH100_ETF_SCALE=41.5

# Loose plausibility ranges - a fetched price outside these gets rejected
# instead of ever being emailed (guards against wrong-symbol/wrong-scale
# bugs like the QQQ one above, for either instrument). Generous on purpose.
GOLD_SANITY_MIN=800
GOLD_SANITY_MAX=8000
TECH100_SANITY_MIN=8000
TECH100_SANITY_MAX=60000

# Candle size for the indicators. 5m/15m/30m/60m are all supported.
CANDLE_INTERVAL=15m

# How often (minutes) the bot checks the market. Checking much more often
# than CANDLE_INTERVAL above just re-reads the same still-forming candle.
CHECK_INTERVAL_MINUTES=15

# --- Active window: when the bot checks/alerts at all -----------------------
# By default: Monday-Friday only, 07:30-23:00 Europe/Sofia. Outside this
# window the bot does nothing and just waits for the next tick - no API
# calls, no emails. Set ACTIVE_DAYS_ONLY=false or widen the hours to go
# back to round-the-clock checking.
ACTIVE_DAYS_ONLY=true
ACTIVE_HOURS_TZ=Europe/Sofia
ACTIVE_START_HOUR=7
ACTIVE_START_MINUTE=30
ACTIVE_END_HOUR=23
ACTIVE_END_MINUTE=0

# --- Analog / historical pattern matching -----------------------------------
# Looks at the shape of the last ANALOG_SHAPE_CANDLES candles, searches the
# previous ANALOG_LOOKBACK_CANDLES for the most similar shape, and looks at
# what actually happened in the ANALOG_FOLLOW_CANDLES right after it. If
# that historical analog is a close enough match (distance <=
# ANALOG_MAX_DISTANCE, deliberately strict - see the comment in config.py),
# it counts as a 7th confluence vote AND its real historical dip/rally is
# used to size take-profit/stop-loss instead of a generic ATR multiple
# (still clamped to a sane range either way - see signals.py).
ANALOG_SHAPE_CANDLES=10
ANALOG_LOOKBACK_CANDLES=192
ANALOG_FOLLOW_CANDLES=8
ANALOG_MAX_DISTANCE=0.18

# How many of the 7 confluence conditions must agree (see README - EMA,
# price vs EMA50, RSI, MACD, Bollinger Bands, candlestick pattern, analog match)
CONFLUENCE_THRESHOLD=3

# By default (24.09) both BUY and SELL are emailed, so your inbox reflects
# what the market is actually doing. Set to true if you only want BUY
# alerts (SELL is still computed/logged either way, just not emailed).
ALERT_ONLY_BUY=false

# Don't re-send the same BUY/SELL alert more often than this (hours). 25 min
# (0.4167) keeps the worst-case daily email count comfortably under Resend's
# free-tier cap of 100/day even if one direction holds all day - see the
# comment in config.py for the math.
REALERT_COOLDOWN_HOURS=0.4167

# Send a "bot started" test email on boot, useful to confirm Resend works
SEND_TEST_EMAIL_ON_START=true
